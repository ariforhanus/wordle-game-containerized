{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2015",
    "strict": false,
    "allowJs": true,
    "checkJs": true,
    "noEmit": false,
    "outDir": "js",
    "rootDir": "src",
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ES2017"],
    "moduleDetection": "auto"
  },
  "include": [
    "src/script.ts",
    "src/daily.ts",
    "src/auth.ts",
    "src/leaderboard.ts"
  ]
}



