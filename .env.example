# Generate these independently; never reuse the old committed values.
POSTGRES_PASSWORD=
SPRING_DATASOURCE_PASSWORD=
JWT_SECRET=
# Bootstrap is optional. Use a unique password of at least 12 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
# Private localhost testing only; keep false for staging/production.
ALLOW_INSECURE_LOCAL_ADMIN=false
# Production: use a real DNS name pointing to the host.
WORDLE_DOMAIN=localhost
# Comma-separated browser origins, including your production HTTPS origin.
CORS_ORIGINS=http://localhost:8080

# Optional account emails; choose your provider later.
PUBLIC_URL=http://localhost:8080
MAIL_ENABLED=false
MAIL_FROM=wordle@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Enable after configuring and testing delivery.
REQUIRE_VERIFIED_EMAIL=false
BACKUP_RETENTION_DAYS=14
# Opt-in: generate a separate private key ring with deploy/setup-mail-outbox.mjs.
MAIL_OUTBOX_ENABLED=false
MAIL_OUTBOX_WORKER_ENABLED=true
MAIL_OUTBOX_ACTIVE_KEY_ID=
MAIL_OUTBOX_KEYS=
MAIL_OUTBOX_MAX_PENDING=10000
MAIL_OUTBOX_MAX_ATTEMPTS=6
MAIL_OUTBOX_LEASE_SECONDS=120
MAIL_OUTBOX_BATCH_SIZE=10
MAIL_OUTBOX_POLL_MILLIS=5000
